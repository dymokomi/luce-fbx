## The luce-fbx export: FBX for Luce. Loading FBX files (binary and ASCII)
## as luce-geocore GeometrySets. Everything here is a thin entry point; the
## work is in document/, scene/ and convert/.
import interop
import memory
import luce_fbx.source as source
import luce_fbx.convert as convert
from luce_fbx.document import Document
from luce_fbx.scene import Scene
from geocore import GeometrySet
from geocore_kernel import adopt_set
from geocore_growing import Growing

## The last load's warnings on this thread, up to 4 KiB of whole lines.
local var last_warnings: u8[4096]
local var last_length: usize

pub struct Fbx:
    let reserved: u8 = 0

    ## The scene of the FBX file at `path` as a GeometrySet (docs/MAPPING.md):
    ## every mesh merged into one mesh in world space, each face's model path
    ## in `path` and material in `material`. `keep_hierarchy` places each
    ## model's mesh as an instance in its own space instead; `instancing`
    ## loads a mesh several models share once, as instances;
    ## `convert_units` turns the file Y-up and scales it to meters;
    ## `normals` imports the file's normals as `N`. What was left out is in
    ## `warnings()`.
    pub static func load(path: str, keep_hierarchy: bool = false, instancing: bool = true, convert_units: bool = false, normals: bool = true) -> interop.Reference[GeometrySet]!:
        let data = try source.read(path)
        defer free(data) in memory.heap
        var document = try Document.parse(data)
        defer document.close()
        var warnings = convert.Warnings()
        defer warnings.close()
        let options = convert.ImportOptions(keep_hierarchy = keep_hierarchy, instancing = instancing, convert_units = convert_units, normals = normals)
        let set = try convert.import_document(&document, &options, &warnings)
        remember(&warnings)
        return try adopt_set(set)

    ## The warnings of this thread's last load, one per line.
    pub static func warnings() -> interop.Owned[str]!:
        return try interop.copy_text((str)last_warnings[..<last_length])

func remember(warnings: const convert.Warnings*):
    let text = warnings.text.view()
    var length = text.length
    if length > last_warnings.length:
        length = last_warnings.length
        while length > 0 and text[length - 1] != 10: length -= 1
    memory.copy(last_warnings[..<length], text[..<length], length)
    last_length = length
