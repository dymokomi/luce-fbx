## Fbx.load and warnings as luced-3d calls them: a Blender cube, the
## generated 7.4/7.5 files with raw and zlib arrays, instancing and Keep
## hierarchy, unit conversion, and damaged files failing cleanly.
from fbx import Fbx
from geocore import invalid
import math

func near(a: float, b: float):
    if math.abs(a - b) >= 0.000001: print(f"near failed: actual={a}, expected={b}")
    assert(math.abs(a - b) < 0.000001)

pub func fbx_tests() -> unit!:
    let cube = Fbx.load("tests/fixtures/blender_279_default_7400_binary.fbx")
    let mesh = cube.mesh() else error(invalid, "no mesh")
    assert(mesh.point_count() == 8 and mesh.face_count() == 6)
    near(mesh.bounds().minimum.x, -1.0)
    near(mesh.bounds().maximum.x, 1.0)
    assert(cube.detail_value("fbx.metersPerUnit") == 1.0)
    for version in [7400, 7500]:
        for compressed in [0, 1]:
            let generated = Fbx.load(f"tests/fixtures/generated_{version}_{compressed}.fbx")
            assert((generated.mesh() else error(invalid, "no mesh")).face_count() == 1)
    let shared = Fbx.load("tests/fixtures/blender_293_instancing_7400_binary.fbx")
    assert(shared.instance_count() == 8)
    let merged = Fbx.load("tests/fixtures/blender_293_instancing_7400_binary.fbx", instancing = false)
    assert((merged.mesh() else error(invalid, "no mesh")).face_count() == 4000)
    let converted = Fbx.load("tests/fixtures/max_edge_visibility_7500_binary.fbx", convert_units = true)
    assert(converted.detail_value("fbx.metersPerUnit") == 1.0)
    for name in ["bad_offset", "truncated"]:
        var failed = false
        discard(Fbx.load(f"tests/fixtures/generated_{name}.fbx")) catch failure:
            failed = true
        assert(failed)
    # Dual quaternion skinning animated: the mesh moves with the frame.
    let early = Fbx.load("tests/fixtures/maya_dq_weights_7500_binary.fbx", time = 0.5).mesh() else error(invalid, "no mesh")
    let late = Fbx.load("tests/fixtures/maya_dq_weights_7500_binary.fbx", frame = 1.2 * 24.0).mesh() else error(invalid, "no mesh")
    assert(early.point_count() == late.point_count() and early.point(0).x != late.point(0).x)
    let info = Fbx.info("tests/fixtures/maya_dq_weights_7500_binary.fbx")
    assert(info.contains("frameRate: 24") and info.contains("Deformer: ") and info.contains("animation: "))
    discard(Fbx.warnings())
    print("PASS Fbx.load and info: binary and ASCII scenes, instancing, units, animation and skins at a time, damaged files")
