## Static FBX geometry: ASCII 7.x arrays, a real Blender binary, generated
## compressed/uncompressed 7.4/7.5 files, corruption and truncation.
from fbx import Fbx
import math

func near(a: float, b: float):
    if math.abs(a - b) >= 0.000001: print(f"near failed: actual={a}, expected={b}")
    assert(math.abs(a - b) < 0.000001)

pub func fbx_tests() -> unit!:
    let fbx_mesh = Fbx.decode_ascii("; FBX 7.4.0 project file\nObjects: { Geometry: 1, \"Geometry::Triangle\", \"Mesh\" { Vertices: *9 { a: 0,0,0,1,0,0,0,1,0 } PolygonVertexIndex: *3 { a: 0,1,-3 } } }")
    assert(fbx_mesh.point_count() == 3 and fbx_mesh.face_count() == 1)
    let binary_fbx = Fbx.load("tests/fixtures/blender_279_default_7400_binary.fbx")
    assert(binary_fbx.point_count() == 8 and binary_fbx.face_count() == 6)
    assert(binary_fbx.index_count() == 36)
    near(binary_fbx.bounds().minimum.x, -1.0)
    near(binary_fbx.bounds().maximum.x, 1.0)
    for version in [7400, 7500]:
        for compressed in [0, 1]:
            let generated = Fbx.load(f"tests/fixtures/generated_{version}_{compressed}.fbx")
            assert(generated.point_count() == 3 and generated.face_count() == 1)
    for name in ["bad_offset", "truncated"]:
        var failed = false
        discard(Fbx.load(f"tests/fixtures/generated_{name}.fbx")) catch failure:
            failed = true
        assert(failed)
    print("PASS FBX ASCII and binary 7.4/7.5 geometry, zlib arrays, corruption and truncation")
