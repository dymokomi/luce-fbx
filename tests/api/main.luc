# luce-fbx's Luce regressions: the public API on the fixtures in ../fixtures, writing what
# it saves into a temporary directory.
from luce_std import files
from fbx_tests import fbx_tests

pub func main(arguments: list[str]) -> int!:
    with files.TemporaryDirectory() as directory:
        fbx_tests(directory.path())
    return 0
